# ==============================================================================
# OMNI-BUILDER STRICT OPT-IN ALLOWLIST (.gitinclude Pattern)
# ==============================================================================

# 1. IGNORE EVERYTHING AT ROOT BY DEFAULT
/*

# 2. ALLOWLIST PRODUCTION SOURCE PACKAGES & TEMPLATES
!/maccre_core/
!/maccre_tui/
!/maccre_dashboard/
!/templates/
!/.agent/

# NOTE: /scripts/ and /tests/ are EXCLUDED from auto-tracking per user policy.
# Add individual scripts/tests manually using: git add -f scripts/my_script.py

# 3. ALLOWLIST CORE ENTRYPOINTS & BUILD CONFIGS
!/pyproject.toml
!/pyrightconfig.json
!/ruff.toml
!/requirements.txt
!/requirements-global.txt
!/requirements-optional.txt
!/requirements-sovereign.txt
!/maccre.py
!/maccre_mcp.py
!/run.py
!/setup_mcp.py
!/setup.ps1
!/.gitattributes
!/.gitignore

# 4. ALLOWLIST OFFICIAL DOCUMENTATION & ROADMAPS
!/README.md
!/LICENSE
!/LICENSE_ADDENDUM.md
!/CONTRIBUTING.md
!/Era2_architectural_roadmap.md
!/Era3_architectural_roadmap.md
!/FeatureRequests.md
!/MACCRE_Operator_Manual.md
!/MACCRE_Agent_Showcase.md
!/maccre_system_architecture_overview.md
!/omni_system_state_doctrine.md

# ==============================================================================
# SUB-DIRECTORY RE-EXCLUSIONS (Prevent runtime clutter)
# ==============================================================================

# Python Runtime & Caches
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.venv/

# Databases & Runtime State
*.db
*.db-shm
*.db-wal
.session_pids.json

# Logs & Render Outputs
*.log
build_pipeline.log
maccre_system.log
dist_omni/

# 5-Tier Datacenter & Transitory Folders
__DATACENTER/
.oracle_artifacts/
.tmp.driveupload/
secrets/
.env
.env.*
